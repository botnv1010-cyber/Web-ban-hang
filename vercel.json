{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,mailer.py,cms.py,data/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/index?route=admin"
    },
    {
      "source": "/api/:route*",
      "destination": "/api/index?route=:route*"
    }
  ]
}

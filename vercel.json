{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,data/plans.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" }
  ]
}

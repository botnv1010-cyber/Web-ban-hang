# Backend only. Set secure values in Vercel Settings; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Your inbox for a private copy of every consultation email.
MAIL_TO=
BLOB_READ_WRITE_TOKEN=
COOKIE_SECURE=1
# Local development only: omit DATABASE_URL to use SQLite.
# CATALOG_DB=/absolute/private/path/catalog.sqlite3
